# Your Supabase project URL
SUPABASE_URL=https://gbkczpjywixipmlaflgy.supabase.co

# Service role key (server-side only — never put this in the web app)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The user_id (auth.users.id) whose leads/CRM data this MCP server may access.
# Every query is scoped to this owner so the service role key can't leak other users' data.
MCP_OWNER_USER_ID=00000000-0000-0000-0000-000000000000
